<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>연구장비 디지털 사용일지</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        body {
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: #ffffff;
            width: 100%;
            max-width: 480px;
            padding: 28px 24px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }
        .header {
            text-align: center;
            margin-bottom: 24px;
        }
        .header h1 {
            font-size: 1.4rem;
            color: #1a1d20;
            margin-bottom: 8px;
        }
        .device-badge {
            display: inline-block;
            background-color: #e8f0fe;
            color: #1a73e8;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.95rem;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-group input:focus, .form-group textarea:focus {
            border-color: #1a73e8;
        }
        .radio-group {
            display: flex;
            gap: 12px;
        }
        .radio-option {
            flex: 1;
            position: relative;
        }
        .radio-option input[type="radio"] {
            display: none;
        }
        .radio-option label {
            display: block;
            text-align: center;
            padding: 14px 0;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1.1rem;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        /* 시작 버튼 선택 시 스타일 */
        .radio-option input[value="시작"]:checked + label {
            background-color: #e6f4ea;
            border-color: #137333;
            color: #137333;
        }
        /* 종료 버튼 선택 시 스타일 */
        .radio-option input[value="종료"]:checked + label {
            background-color: #fce8e6;
            border-color: #c5221f;
            color: #c5221f;
        }
        .btn-submit {
            width: 100%;
            padding: 14px;
            background-color: #1a73e8;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 8px;
        }
        .btn-submit:hover {
            background-color: #1557b0;
        }
        .btn-submit:disabled {
            background-color: #94a3b8;
            cursor: not-allowed;
        }
        .message {
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-size: 0.95rem;
            display: none;
        }
        .message.success {
            background-color: #d1e7dd;
            color: #0f5132;
        }
        .message.error {
            background-color: #f8d7da;
            color: #842029;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>연구장비 사용일지</h1>
        <div class="device-badge" id="deviceDisplay">장비 확인 중...</div>
    </div>

    <form id="usageForm">
        <div class="form-group">
            <label>사용 구분 *</label>
            <div class="radio-group">
                <div class="radio-option">
                    <input type="radio" id="statusStart" name="status" value="시작" required>
                    <label for="statusStart">▶ 사용 시작</label>
                </div>
                <div class="radio-option">
                    <input type="radio" id="statusEnd" name="status" value="종료" required>
                    <label for="statusEnd">■ 사용 종료</label>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="department">소속 (학과/연구실) *</label>
            <input type="text" id="department" placeholder="예: 신소재공학과 / 나노소재연구실" required>
        </div>

        <div class="form-group">
            <label for="userName">사용자 이름 *</label>
            <input type="text" id="userName" placeholder="홍길동" required>
        </div>

        <div class="form-group">
            <label for="note">특이사항 (선택)</label>
            <textarea id="note" rows="3" placeholder="장비 이상 유무, 시약 사용량 등 기록"></textarea>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">기록 제출하기</button>
    </form>

    <div id="responseMessage" class="message"></div>
</div>

<script>
    // ⚠️ [중요] 1단계에서 생성한 Google Apps Script의 웹 앱 URL을 아래에 넣으세요!
    const GAS_WEB_APP_URL = "https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec";

    // 1. URL 파라미터에서 device 값 추출 (예: ?device=EQ01)
    const urlParams = new URLSearchParams(window.location.search);
    const deviceId = urlParams.get('device') || '미지정 장비';

    // 화면에 장비 ID 표시
    document.getElementById('deviceDisplay').innerText = `장비: ${deviceId}`;

    // 2. 폼 제출 이벤트 처리
    const form = document.getElementById('usageForm');
    const submitBtn = document.getElementById('submitBtn');
    const responseMsg = document.getElementById('responseMessage');

    form.addEventListener('submit', function(e) {
        e.preventDefault();

        // 중복 제출 방지
        submitBtn.disabled = true;
        submitBtn.innerText = "전송 중...";
        responseMsg.style.display = "none";

        // 입력 데이터 수집
        const payload = {
            deviceId: deviceId,
            department: document.getElementById('department').value,
            userName: document.getElementById('userName').value,
            status: document.querySelector('input[name="status"]:checked').value,
            note: document.getElementById('note').value
        };

        // Google Apps Script로 데이터 전송 (POST)
        fetch(GAS_WEB_APP_URL, {
            method: 'POST',
            mode: 'no-cors', // CORS 에러 방지
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(() => {
            // 성공 메시지 표시
            responseMsg.className = "message success";
            responseMsg.innerText = "✅ 기록이 성공적으로 저장되었습니다!";
            responseMsg.style.display = "block";

            // 폼 초기화 (소속/이름은 사용자 편의를 위해 유지하려면 아래 주석 해제)
            form.reset();
            document.getElementById('deviceDisplay').innerText = `장비: ${deviceId}`;
        })
        .catch(error => {
            console.error('Error:', error);
            responseMsg.className = "message error";
            responseMsg.innerText = "❌ 저장에 실패했습니다. 다시 시도해 주세요.";
            responseMsg.style.display = "block";
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerText = "기록 제출하기";
        });
    });
</script>

</body>
</html>
