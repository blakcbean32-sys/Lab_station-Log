<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>연구장비 디지털 사용일지</title>
    <!-- Supabase JS SDK 로드 -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        body {
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: #ffffff;
            width: 100%;
            max-width: 480px;
            padding: 28px 24px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .header h1 {
            font-size: 1.4rem;
            color: #1a1d20;
            margin-bottom: 8px;
        }
        .device-badge {
            display: inline-block;
            background-color: #e8f0fe;
            color: #1a73e8;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.95rem;
        }
        /* 실시간 상태 표시 박스 스타일 */
        .status-box {
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: 600;
            font-size: 0.95rem;
        }
        .status-box.available { background-color: #e6f4ea; color: #137333; border: 1px solid #ceead6; } /* 정상 - 사용가능 */
        .status-box.in-use { background-color: #e8f0fe; color: #1a73e8; border: 1px solid #d2e3fc; } /* 정상 - 사용중 */
        .status-box.maintenance { background-color: #fef7e0; color: #b06000; border: 1px solid #feefc3; } /* 점검중 */
        .status-box.broken { background-color: #fce8e6; color: #c5221f; border: 1px solid #fad2cf; } /* 고장 */

        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-group input:focus, .form-group textarea:focus {
            border-color: #1a73e8;
        }
        .radio-group {
            display: flex;
            gap: 12px;
        }
        .radio-option {
            flex: 1;
            position: relative;
        }
        .radio-option input[type="radio"] {
            display: none;
        }
        .radio-option label {
            display: block;
            text-align: center;
            padding: 14px 0;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1.1rem;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .radio-option input[value="시작"]:checked + label {
            background-color: #e6f4ea;
            border-color: #137333;
            color: #137333;
        }
        .radio-option input[value="종료"]:checked + label {
            background-color: #fce8e6;
            border-color: #c5221f;
            color: #c5221f;
        }
        .btn-submit {
            width: 100%;
            padding: 14px;
            background-color: #1a73e8;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 8px;
        }
        .btn-submit:hover { background-color: #1557b0; }
        .btn-submit:disabled { background-color: #94a3b8; cursor: not-allowed; }
        
        .message {
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-size: 0.95rem;
            display: none;
        }
        .message.success { background-color: #d1e7dd; color: #0f5132; }
        .message.error { background-color: #f8d7da; color: #842029; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>연구장비 사용일지</h1>
        <!-- 장비 이름 표시 -->
        <div class="device-badge" id="deviceDisplay">장비 확인 중...</div>
    </div>

    <!-- 상태 표시 박스 (정상/점검중/고장 및 사용가능/사용중) -->
    <div id="statusBox" class="status-box available">상태 불러오는 중...</div>

    <form id="usageForm">
        <div class="form-group">
            <label>사용 구분 *</label>
            <div class="radio-group">
                <div class="radio-option">
                    <input type="radio" id="statusStart" name="status" value="시작" required>
                    <label for="statusStart">▶ 사용 시작</label>
                </div>
                <div class="radio-option">
                    <input type="radio" id="statusEnd" name="status" value="종료" required>
                    <label for="statusEnd">■ 사용 종료</label>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="department">소속 (기업명) *</label>
            <input type="text" id="department" placeholder="예: 경기도경제과학진흥원" required>
        </div>

        <div class="form-group">
            <label for="userName">사용자 이름 *</label>
            <input type="text" id="userName" placeholder="홍길동" required>
        </div>

        <div class="form-group">
            <label for="note">특이사항 (선택)</label>
            <textarea id="note" rows="3" placeholder="장비 이상 유무 등 기록"></textarea>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">기록 제출하기</button>
    </form>

    <div id="responseMessage" class="message"></div>
</div>

<script>
    // =========================================================
    // 1. Supabase 연동 정보
    // =========================================================
    const SUPABASE_URL = "https://acdfxgazhhzrdbvhxale.supabase.co";

    // 반드시 eyJhbGciOi... 로 시작하는 긴 문자열(Legacy anon key)을 넣어야 합니다.
    const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFjZGZ4Z2F6aGh6cmRidmh4YWxlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Mzg1ODAzNTMsImV4cCI6MjA1NDE1NjM1M30.실제_복사한_전체_키";

    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    // =========================================================
    // 2. URL 파라미터 추출 (?device=EQ01)
    // =========================================================
    const urlParams = new URLSearchParams(window.location.search);
    const deviceId = urlParams.get('device') || '미지정';

    let currentDeviceName = deviceId;

    // =========================================================
    // 3. 장비 정보(device_name/status) 및 최신 사용 로그 불러오기
    // =========================================================
    async function loadDeviceInfoAndStatus() {
        const statusBox = document.getElementById('statusBox');
        const submitBtn = document.getElementById('submitBtn');

        if (deviceId === '미지정') {
            document.getElementById('deviceDisplay').innerText = "장비 ID 미지정";
            statusBox.style.display = 'none';
            return;
        }

        // [A] equipments 테이블에서 장비 정보 조회
        const { data: equipData, error: equipError } = await supabase
            .from('equipments')
            .select('*')
            .eq('device_id', deviceId)
            .single();

        if (equipError || !equipData) {
            document.getElementById('deviceDisplay').innerText = `장비: ${deviceId}`;
        } else {
            currentDeviceName = equipData.device_name;
            document.getElementById('deviceDisplay').innerText = currentDeviceName;
            
            // [B] 장비 상태가 '점검중' 또는 '고장'인 경우 제출 차단
            if (equipData.status === '점검중') {
                statusBox.className = "status-box maintenance";
                statusBox.innerHTML = "🟡 <b>현재 점검 중인 장비입니다.</b> (사용 불가)";
                submitBtn.disabled = true;
                return;
            } else if (equipData.status === '고장') {
                statusBox.className = "status-box broken";
                statusBox.innerHTML = "🔴 <b>현재 고장/수리 중인 장비입니다.</b> (사용 불가)";
                submitBtn.disabled = true;
                return;
            }
        }

        // [C] 상태가 '정상'일 경우 최신 사용로그를 확인하여 '사용가능' / '사용중' 판별
        const { data: logData } = await supabase
            .from('equipment_logs')
            .select('*')
            .eq('device_id', deviceId)
            .order('created_at', { ascending: false })
            .limit(1);

        if (!logData || logData.length === 0 || logData[0].status === '종료') {
            statusBox.className = "status-box available";
            statusBox.innerHTML = "🟢 <b>정상 (사용 가능)</b>";
            document.getElementById('statusStart').checked = true;
        } else {
            const lastLog = logData[0];
            statusBox.className = "status-box in-use";
            statusBox.innerHTML = `🔵 <b>사용 중</b> (${lastLog.user_name} / ${lastLog.department})`;
            document.getElementById('statusEnd').checked = true;
        }
    }

    loadDeviceInfoAndStatus();

    // =========================================================
    // 4. 폼 제출 이벤트 (equipment_logs 테이블에 저장)
    // =========================================================
    const form = document.getElementById('usageForm');
    const submitBtn = document.getElementById('submitBtn');
    const responseMsg = document.getElementById('responseMessage');

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        submitBtn.disabled = true;
        submitBtn.innerText = "저장 중...";
        responseMsg.style.display = "none";

        const payload = {
            device_id: deviceId,
            department: document.getElementById('department').value,
            user_name: document.getElementById('userName').value,
            status: document.querySelector('input[name="status"]:checked').value,
            note: document.getElementById('note').value
        };

        const { error } = await supabase.from('equipment_logs').insert([payload]);

        if (error) {
            responseMsg.className = "message error";
            responseMsg.innerText = "❌ 저장에 실패했습니다: " + error.message;
        } else {
            responseMsg.className = "message success";
            responseMsg.innerText = "✅ 기록이 성공적으로 저장되었습니다!";
            form.reset();
            loadDeviceInfoAndStatus(); // 제출 후 상태 갱신
        }

        responseMsg.style.display = "block";
        submitBtn.disabled = false;
        submitBtn.innerText = "기록 제출하기";
    });
</script>
</body>
</html>
